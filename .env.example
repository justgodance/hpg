# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hpg_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Async Database URL
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# App settings
PROJECT_NAME="Guild Quest Board"
DEBUG=True

# Game balance overrides (optional, shown with defaults)
MAX_BOARD_SIZE=12
DEFAULT_FREE_DROPS=2
DEFAULT_REROLLS_LEFT=1
QUESTS_PER_REROLL_RECHARGE=3
INFLATION_INTERVAL_HOURS=24
INFLATION_RATE_PER_INTERVAL=0.2
REROLL_PENALTY_RATE=0.1
UNDERDOG_SCORE_GAP=2000
UNDERDOG_BONUS_MULTIPLIER=1.2
CHALLENGE_ROLL_COUNT=3
